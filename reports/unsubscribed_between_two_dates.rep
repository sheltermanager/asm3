<table border="1">
<thead>
<tr>
<th>Name</th>
<th>Code</th>
<th>Date Added</th>  
<th>Comments</th>  
</thead>
<tbody>
HEADER$$

$$BODY
<tr>
<td><a target="_blank" href="person?id=$OID">$OWNERNAME</a></td>
<td>$OWNERCODE</td>
<td>$CREATEDDATE</td>  
<td>$COMMENTS</td>    
</tr>
BODY$$

$$FOOTER
</table>
<h2>Total: {COUNT.OWNERNAME}</h2>
FOOTER$$